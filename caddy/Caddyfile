# HTTP(S) server for the site: generated pages, playlists and audio.
#
# Dev (from the repository root):
#   caddy run --config caddy/Caddyfile --adapter caddyfile
# Kubernetes: the `web` image (docker/Dockerfile) sets SITE_ADDRESS=:8080 (plain HTTP,
# TLS is done by the Ingress), BUILD_DIR=/site and MEDIA_DIR=/media. Without an Ingress,
# SITE_ADDRESS set to a domain makes Caddy get a certificate itself.
#
# Range requests (seeking in players) are supported by file_server out of the box.
{
	# No admin API: the config is static, nothing should be able to change it at runtime.
	admin off

	# The visitor's address behind a proxy (Traefik): taken from these headers, but only
	# when the request comes from a trusted proxy (TRUSTED_PROXIES: CIDRs or
	# private_ranges, separated by spaces). The access log then has client_ip.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		client_ip_headers X-Real-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS::8080} {
	# Access log to stderr (one JSON line per request): the container log.
	log {
		output stderr
	}

	header {
		X-Content-Type-Options nosniff
		# same-origin: keyboard navigation uses the referrer to select the podcast you
		# came back from; nothing goes to other sites
		Referrer-Policy same-origin
		X-Frame-Options DENY
		# Keep the site out of search engines and their caches (with /robots.txt)
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
		# Pages carry their own inline styles and scripts; only fonts come from Google.
		Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# Audio library (read-only mount). Only audio: the library may hold other files
	# (there is an index.html), and HTML served from our origin could run scripts.
	handle_path /media/* {
		@not_audio not path *.mp3 *.MP3
		respond @not_audio 404
		root * {$MEDIA_DIR:/media/podcasts}
		file_server {
			hide .*
		}
	}

	# Playlists: as attachments, otherwise Chrome and Safari open .m3u8 in their
	# built-in HLS player instead of downloading.
	handle_path /playlists/* {
		root * {$BUILD_DIR:build}/playlists
		header Content-Disposition attachment
		file_server
	}

	# Generated pages.
	handle {
		root * {$BUILD_DIR:build}/www
		encode zstd gzip
		file_server {
			hide .*
		}
	}
}
