{
  "name": "podcast-site",
  "image": "mcr.microsoft.com/devcontainers/rust:1",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    // Docker of its own inside the container (isolated from the host's Docker), for
    // building the multi-arch images: docker buildx. Needs a privileged container.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // GitHub CLI: push, CI runs and their logs (gh run watch / view)
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/anthropics/devcontainer-features/claude-code"
  ],

  "mounts": [
    "source=/media/podcasts,target=/media/podcasts,type=bind,readonly,bind-propagation=rslave",
    "source=podcast-site-claude,target=/home/vscode/.claude,type=volume",
    "source=podcast-site-cargo,target=/usr/local/cargo/registry,type=volume",
    // gh login (the token) survives a rebuild; it never goes into the repository
    "source=podcast-site-gh,target=/home/vscode/.config/gh,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },

  "forwardPorts": [7070, 8080],
  // Gopher and HTTP are also published on the radxa host itself, for clients in
  // the LAN (forwardPorts only reach the machine running VS Code).
  "appPort": ["7070:7070", "8080:8080"],
  "portsAttributes": {
    "7070": { "label": "Gopher (dev)" },
    "8080": { "label": "HTTP (dev)" }
  },

  "postCreateCommand": "sh .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ]
    }
  },

  "remoteUser": "vscode"
}
